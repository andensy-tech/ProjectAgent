# ============================================================
# Project Agent 环境变量样例
# 复制为 .env 后按需填写：cp .env.example .env
# 优先级：.env > 用户设置页（LLM/MCP/CI 构建等按用户在设置页配置，见 README）
# ============================================================

# ── 基础 ──────────────────────────────────────────────
# 生产环境必须改为随机字符串（install.sh 会自动生成）
SECRET_KEY=change-me-in-production
DEBUG=false
BACKEND_PORT=8000

# 数据库：开发默认 SQLite；生产改 PostgreSQL
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/project_agent
DATABASE_URL=sqlite+aiosqlite:///./data/project_agent.db

# ── LLM（也可在设置页按用户配置，二者取其一）────────────
# 商用 LLM：语义理解/复杂推理
COMMERCIAL_LLM_PROVIDER=deepseek
COMMERCIAL_LLM_API_BASE=https://api.deepseek.com/v1
COMMERCIAL_LLM_API_KEY=
COMMERCIAL_LLM_MODEL=deepseek-chat

# 本地 LLM：数据处理（敏感数据不出域），可选
LOCAL_LLM_API_BASE=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=

# ── 脱敏部署参数（开源版默认值均为中性示例）─────────────
# Gerrit 实例映射：逗号分隔 host=instance 对。
# CL URL 解析、MCP 客户端名（gerrit_<instance>）都依赖它。
# 例：GERRIT_HOSTS="gerrit.example.com=gerrit1,gerrit2.example.com=gerrit2"
GERRIT_HOSTS=

# Jira/Confluence 外部链接前缀（报告 HTML、前端链接跳转用）
JIRA_WEB_URL=https://jira.example.com
CONFLUENCE_BASE_URL=https://confluence.example.com

# CL 监控默认 JQL label / Confluence 报告空间
JIRA_MONITOR_LABEL=release_verified
JIRA_MONITOR_EPICS=TV-900001,TV-900002
CONFLUENCE_SPACE_KEY=~YourName
CONFLUENCE_PARENT_ID=

# ── MCP 服务（推荐在设置页「MCP 服务」按用户配置）────────
# 首次启动后登录 → 设置页 → MCP 服务，填 Jira/Confluence/Gerrit 的
# streamableHttp 地址与凭据。未配置时相关功能返回中文引导提示。

# ── CL 监控 ───────────────────────────────────────────
# 灰度开关：true = 照常扫描入库，但 Jira 提醒评论只写日志不发评论
CL_SCAN_DRY_RUN=false
CL_SCAN_INTERVAL_SECONDS=86400

# ── 飞书渠道（可选）────────────────────────────────────
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ── Jira 自定义字段（按你的 Jira 实例调整，一般默认即可）──
JIRA_CUSTOM_FIELD_USER=
JIRA_CUSTOM_FIELD_LIST=
JIRA_CUSTOM_FIELD_CANNOT_SET=
JIRA_CUSTOM_FIELD_EPIC_LINK=

# ── 其他 ──────────────────────────────────────────────
DATA_MASKING_LEVEL=normal
ENABLE_AUDIT_LOG=true
# 预置 admin 密码的 bcrypt hash（仅 DEBUG 初始化用；留空则默认 admin123 并强制首登改密）
ADMIN_PASSWORD_HASH=
